{
  "_comment": "Blog article template. Generate per post from frontmatter. Named author with a real bio page is not optional — anonymous content is discounted by both Google and AI systems.",
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "{{ post.title }} — max 110 characters",
  "description": "{{ post.meta_description }}",
  "image": "https://bmtechx.in/assets/blog/{{ post.slug }}.jpg",
  "datePublished": "{{ post.published_iso }}",
  "dateModified": "{{ post.updated_iso }}",
  "author": {
    "@type": "Person",
    "name": "{{ post.author.name }}",
    "url": "https://bmtechx.in/about/#{{ post.author.slug }}",
    "jobTitle": "{{ post.author.role }}",
    "worksFor": { "@id": "https://bmtechx.in/#organization" }
  },
  "publisher": { "@id": "https://bmtechx.in/#organization" },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": "https://bmtechx.in/blog/{{ post.slug }}/"
  },
  "inLanguage": "en-IN"
}
